API_ID=your_telegram_api_id
API_HASH=your_telegram_api_hash
BOT_TOKEN=your_bot_token_from_botfather
ADMIN_ID=your_telegram_user_id
BOT_USERNAME=your_bot_username
ACCOUNT_NAME=Your Full Name
CBE_ACCOUNT=1000000000000
ABYSSINIA_ACCOUNT=00000000
TELEBIRR_NUMBER=0900000000
AWASH_ACCOUNT=00000000000000
SUPPORT_CONTACT=@your_support_username
VIP_LINK=https://t.me/addlist/your_invite_link
TESSERACT_CMD=

# CBE ደረሰኝ ገጽ (mbreciept.cbe.com.et) ራንደር ለማድረግ Playwright የሚጠብቅበት ከፍተኛ
# ጊዜ (ms)። ካልተቀመጠ ነባሪው 30000 (30 ሰከንድ) ነው። ደካማ ኢንተርኔት ላይ ካስፈለገ ብቻ ጨምር።
CBE_RENDER_TIMEOUT_MS=30000

# Supabase Database (PostgreSQL Cloud)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key

# የክፍያ tolerance (ብር) — ነባሪው 10 ብር ነው (ከሚጠበቀው ሳይበልጥ)
# ለምሳሌ: ተጠቃሚ 300 ብር ሲከፍል 300-310 ብር ያልፋል
PAYMENT_TOLERANCE=10
